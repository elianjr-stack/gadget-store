// ─────────────────────────────────────────────────────
// GadgetStore – Complete PostgreSQL Schema via Prisma
// ─────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  UPAY
  SSLCOMMERZ
  BANK_TRANSFER
  CASH_ON_DELIVERY
  EMI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VariantType {
  COLOR
  STORAGE
  REGION
  RAM
  SIZE
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  COMING_SOON
  DISCONTINUED
}

enum BannerPosition {
  HERO
  SIDEBAR
  CATEGORY
  BRAND
  POPUP
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationType {
  ORDER_UPDATE
  STOCK_ALERT
  PRICE_DROP
  PROMOTIONAL
}

enum DeliveryZone {
  DHAKA
  OUTSIDE_DHAKA
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUND_PROCESSING
  COMPLETED
}

enum WarrantyClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  IN_REPAIR
  COMPLETED
  REJECTED
}

// ═══════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  password        String
  name            String
  avatar          String?
  role            UserRole  @default(CUSTOMER)
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  language        String    @default("bn") // bn or en
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  stockAlerts     StockAlert[]
  recentlyViewed  RecentlyViewed[]
  sessions        Session[]
  expenses        Expense[]
  loginHistories  LoginHistory[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Address {
  id            String       @id @default(cuid())
  userId        String
  label         String       @default("Home") // Home, Office, etc.
  fullName      String
  phone         String
  division      String
  district      String
  area          String
  streetAddress String
  postalCode    String?
  isDefault     Boolean      @default(false)
  deliveryZone  DeliveryZone @default(OUTSIDE_DHAKA)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ═══════════════════════════════════════════════════════
// CATALOG
// ═══════════════════════════════════════════════════════

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  banner      String?
  description String?
  descriptionBn String?
  website     String?
  brandColor  String?   @default("#4F46E5")
  accentColor String?   @default("#06B6D4")
  textColor   String?   @default("#FFFFFF")
  badgeColor  String?   @default("#EEF2FF")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  metaTitle   String?
  metaDescription String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
  @@index([isActive])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameBn      String?
  slug        String    @unique
  icon        String?
  image       String?
  banner      String?
  description String?
  descriptionBn String?
  parentId    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  metaTitle   String?
  metaDescription String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  specs       CategorySpec[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model CategorySpec {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  nameBn     String?
  unit       String?
  sortOrder  Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

model Product {
  id              String      @id @default(cuid())
  name            String
  nameBn          String?
  slug            String      @unique
  sku             String      @unique
  barcode         String?     @unique
  brandId         String
  categoryId      String
  shortDescription String?
  shortDescriptionBn String?
  description     String?     @db.Text
  descriptionBn   String?     @db.Text
  price           Decimal     @db.Decimal(12, 2)
  discountPrice   Decimal?    @db.Decimal(12, 2)
  discountPercent Int?
  costPrice       Decimal?    @db.Decimal(12, 2)
  stockStatus     StockStatus @default(IN_STOCK)
  stockQuantity   Int         @default(0)
  lowStockThreshold Int       @default(5)
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  isNewArrival    Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  isFlashDeal     Boolean     @default(false)
  flashDealEnds   DateTime?
  preOrderDate    DateTime?
  warrantyMonths  Int?
  warrantyTerms   String?
  emiAvailable    Boolean     @default(false)
  emiMonths       Int[]       @default([])
  weight          Decimal?    @db.Decimal(8, 2)
  viewCount       Int         @default(0)
  soldCount       Int         @default(0)
  avgRating       Decimal     @default(0) @db.Decimal(3, 2)
  reviewCount     Int         @default(0)
  metaTitle       String?
  metaDescription String?
  tags            String[]    @default([])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  brand           Brand       @relation(fields: [brandId], references: [id])
  category        Category    @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  specifications  ProductSpec[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  priceHistory    PriceHistory[]
  stockAlerts     StockAlert[]
  recentlyViewed  RecentlyViewed[]
  comparisons     ComparisonItem[]
  relatedFrom     RelatedProduct[] @relation("RelatedFrom")
  relatedTo       RelatedProduct[] @relation("RelatedTo")

  @@index([slug])
  @@index([sku])
  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isFlashDeal])
  @@index([price])
  @@index([createdAt])
  @@index([soldCount])
  @@index([avgRating])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  type        VariantType
  name        String      // e.g. "Midnight Blue", "256GB", "Official BD"
  nameBn      String?
  value       String      // machine-readable value
  price       Decimal?    @db.Decimal(12, 2) // override price
  discountPrice Decimal?  @db.Decimal(12, 2)
  sku         String?
  stock       Int         @default(0)
  stockStatus StockStatus @default(IN_STOCK)
  image       String?
  isDefault   Boolean     @default(false)
  sortOrder   Int         @default(0)

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([type])
}

model ProductSpec {
  id        String @id @default(cuid())
  productId String
  group     String // e.g. "Display", "Processor", "Battery"
  groupBn   String?
  name      String // e.g. "Screen Size", "Chipset"
  nameBn    String?
  value     String // e.g. "6.7 inches", "Snapdragon 8 Gen 3"
  valueBn   String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([group])
}

model RelatedProduct {
  id        String @id @default(cuid())
  productId String
  relatedId String

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Decimal  @db.Decimal(12, 2)
  discountPrice Decimal? @db.Decimal(12, 2)
  changedBy String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════
// SHOPPING
// ═══════════════════════════════════════════════════════

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model ComparisonItem {
  id        String   @id @default(cuid())
  sessionId String   // can be anon session or user id
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
  @@index([sessionId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([viewedAt])
}

// ═══════════════════════════════════════════════════════
// ORDERS & PAYMENTS
// ═══════════════════════════════════════════════════════

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  addressId       String
  subtotal        Decimal       @db.Decimal(12, 2)
  deliveryCharge  Decimal       @db.Decimal(12, 2) @default(0)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  couponId        String?
  total           Decimal       @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  transactionId   String?
  note            String?
  isGuestOrder    Boolean       @default(false)
  guestEmail      String?
  guestPhone      String?
  deliveryZone    DeliveryZone
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  trackingNumber  String?
  courierName     String?
  invoicePath     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  address         Address       @relation(fields: [addressId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  returnRequest   ReturnRequest?
  warrantyClaims  WarrantyClaim[]
  payment         Payment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  name        String
  sku         String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  total       Decimal @db.Decimal(12, 2)
  image       String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("BDT")
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  gatewayResponse Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

// ═══════════════════════════════════════════════════════
// RETURNS & WARRANTY
// ═══════════════════════════════════════════════════════

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String       @unique
  reason      String
  description String?
  images      String[]     @default([])
  status      ReturnStatus @default(REQUESTED)
  refundAmount Decimal?    @db.Decimal(12, 2)
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
}

model WarrantyClaim {
  id          String              @id @default(cuid())
  orderId     String
  productName String
  serialNumber String?
  issue       String
  description String?
  images      String[]            @default([])
  status      WarrantyClaimStatus @default(SUBMITTED)
  resolution  String?
  processedBy String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════
// COUPONS & PROMOTIONS
// ═══════════════════════════════════════════════════════

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minOrderAmount  Decimal?   @db.Decimal(12, 2)
  maxDiscount     Decimal?   @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int        @default(0)
  perUserLimit    Int        @default(1)
  isActive        Boolean    @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  orders Order[]

  @@index([code])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════
// REVIEWS
// ═══════════════════════════════════════════════════════

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      // 1-5
  title     String?
  comment   String?
  images    String[] @default([])
  isVerified Boolean @default(false)
  isApproved Boolean @default(true)
  helpfulCount Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

// ═══════════════════════════════════════════════════════
// CMS & BANNERS
// ═══════════════════════════════════════════════════════

model Banner {
  id        String         @id @default(cuid())
  title     String
  titleBn   String?
  subtitle  String?
  subtitleBn String?
  image     String
  imageMobile String?
  link      String?
  position  BannerPosition @default(HERO)
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([position])
  @@index([isActive])
}

model Page {
  id        String   @id @default(cuid())
  title     String
  titleBn   String?
  slug      String   @unique
  content   String   @db.Text
  contentBn String?  @db.Text
  isActive  Boolean  @default(true)
  metaTitle String?
  metaDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ═══════════════════════════════════════════════════════
// DELIVERY
// ═══════════════════════════════════════════════════════

model DeliveryCharge {
  id          String       @id @default(cuid())
  zone        DeliveryZone
  minWeight   Decimal?     @db.Decimal(8, 2)
  maxWeight   Decimal?     @db.Decimal(8, 2)
  charge      Decimal      @db.Decimal(12, 2)
  freeAbove   Decimal?     @db.Decimal(12, 2) // free delivery above this amount
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([zone])
}

model District {
  id       String       @id @default(cuid())
  name     String       @unique
  nameBn   String?
  division String
  zone     DeliveryZone
}

// ═══════════════════════════════════════════════════════
// NOTIFICATIONS & ALERTS
// ═══════════════════════════════════════════════════════

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model StockAlert {
  id        String   @id @default(cuid())
  userId    String
  productId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ═══════════════════════════════════════════════════════
// ADMIN & LOGGING
// ═══════════════════════════════════════════════════════

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // e.g. "product.create", "order.update"
  entity    String   // e.g. "Product", "Order"
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  group String @default("general")

  @@index([key])
  @@index([group])
}

// ═══════════════════════════════════════════════════════
// BUSINESS EXPENSES & CASH FLOW
// ═══════════════════════════════════════════════════════

model Expense {
  id            String   @id @default(cuid())
  title         String
  category      String   // Rent, Salaries, Utilities, Packaging, Marketing, Shipping, Maintenance, Other
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  paymentMethod String?  // Cash, Bank, bKash, Card
  notes         String?
  referenceNo   String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User?    @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([date])
}

// ═══════════════════════════════════════════════════════
// SECURITY & AUDIT
// ═══════════════════════════════════════════════════════

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String
  email         String?
  ipAddress     String?
  userAgent     String?
  device        String?
  status        String   @default("SUCCESS") // SUCCESS, FAILED
  failureReason String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

