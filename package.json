{
  "name": "gadget-store",
  "version": "1.0.0",
  "private": true,
  "description": "GadgetStore BD – Full-stack e-commerce platform for the Bangladesh gadget market",
  "scripts": {
    "dev:backend": "cd packages/backend && npm run start:dev",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "dev:admin": "cd packages/admin && npm run dev",
    "build:backend": "cd packages/backend && npm run build",
    "build:frontend": "cd packages/frontend && npm run build",
    "build:admin": "cd packages/admin && npm run build",
    "db:migrate": "cd packages/backend && npx prisma migrate dev",
    "db:seed": "cd packages/backend && npx prisma db seed",
    "db:studio": "cd packages/backend && npx prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  }
}
